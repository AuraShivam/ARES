{$ARES_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}

	@django path /api/* /admin* /static/* /ws/*
	handle @django {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
