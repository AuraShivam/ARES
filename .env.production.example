# Copy to .env.production and replace every placeholder locally. Never commit the copy.
ARES_DOMAIN=ares.example.com
ARES_IMAGE_TAG=release-1
PYTHON_IMAGE=python:3.13.15-slim-bookworm
NODE_IMAGE=node:22.23-alpine3.24
CADDY_IMAGE=caddy:2.11.7-alpine
POSTGRES_CLIENT_IMAGE=postgres:17-alpine

# Managed PostgreSQL. Provision a dedicated least-privilege application role.
POSTGRES_DB=ares
POSTGRES_USER=ares_app
POSTGRES_PASSWORD=replace-with-provider-issued-secret
POSTGRES_HOST=replace-with-managed-postgres-host
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
# If the provider requires a private CA, mount it read-only at this path in each
# backend and backup service and set the actual path here. Leave blank otherwise.
POSTGRES_SSLROOTCERT=
ARES_REDIS_URL=rediss://replace-user:replace-password@replace-redis-host:6379/0

# Django production configuration. Use a unique random value from a secret manager.
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ares.example.com
CORS_ALLOWED_ORIGINS=https://ares.example.com
CSRF_TRUSTED_ORIGINS=https://ares.example.com
DJANGO_TRUST_PROXY_SSL=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
ARES_API_TOKEN_TTL_HOURS=8

# GDACS polling. Outbound HTTPS access is required by the worker.
ARES_GDACS_POLL_INTERVAL_SECONDS=360
ARES_GDACS_MIN_ALERT_LEVEL=orange
ARES_GDACS_USER_AGENT="ARES/1.0 (global-disaster-alert-ingestion)"
ARES_GDACS_CA_BUNDLE=

# Notification delivery stays disabled until SMTP credentials and recipients
# are configured. Start the optional worker only after end-to-end mail checks.
ARES_EMAIL_DELIVERY_ENABLED=false
ARES_NOTIFICATION_OPERATIONS_EMAILS=
ARES_NOTIFICATION_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# External action execution stays disabled until an approved HTTPS target is set.
ARES_ACTION_EXECUTION_ENABLED=false
ARES_ACTION_WEBHOOK_URL=
ARES_ACTION_WEBHOOK_ALLOWED_HOSTS=
ARES_ACTION_WEBHOOK_TOKEN=

ARES_RISK_ALERT_SCORE_THRESHOLD=60
ARES_RISK_ALERT_COOLDOWN_MINUTES=60
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
