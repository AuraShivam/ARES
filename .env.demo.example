# Local-only demo values. Compose binds the web port to 127.0.0.1 and does not
# publish the PostgreSQL port. Never reuse these values for any shared system.
DJANGO_SECRET_KEY=ares-demo-only-change-before-any-shared-use
POSTGRES_DB=ares_demo
POSTGRES_USER=ares_demo
POSTGRES_PASSWORD=ares-demo-only-local-db-password
