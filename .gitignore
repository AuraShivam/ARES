# Python environment, cache, and local database
.venv/
**/.venv/
__pycache__/
*.py[cod]
**/db.sqlite3

# Frontend dependencies and build output
**/node_modules/
**/dist/
**/.vite/

# Local configuration and logs
.env
.env.production
.env.demo
secrets/
compose.production.ca.yaml
*.log
.DS_Store
.pnpm-store/
backups/
*.dump

# Supplied reference PDFs stay in the workspace but out of source history.
/*.pdf
/docs/references/*.pdf

# Local-only legacy artifacts and archives
/.local/
